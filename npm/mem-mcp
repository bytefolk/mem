#!/usr/bin/env node

/**
 * mem-mcp — npm bin wrapper.
 *
 * Resolves the platform binary into npm/bin/, verifies or bootstraps it through
 * install.js, and runs it with inherited stdio, which is what the MCP stdio
 * transport needs.
 *
 * This is deliberately a Node script rather than a POSIX shell script: npm
 * generates cmd/ps1 shims on Windows, and a bash shebang there cannot start the
 * binary at all. Node is guaranteed present because npm just ran.
 */

"use strict";

const { spawn } = require("child_process");
const { platform, arch } = require("os");
const { join } = require("path");
const { install } = require("./install");
const { assetFor } = require("./platforms");

function installerLogger(logger) {
  return {
    log(...args) {
      logger.error(...args);
    },
    warn(...args) {
      logger.error(...args);
    },
  };
}

async function run(options = {}) {
  const osPlatform = options.osPlatform || platform();
  const osArch = options.osArch || arch();
  const binDir = options.binDir || join(__dirname, "bin");
  const bootstrap = options.install || install;
  const spawnProcess = options.spawn || spawn;
  const args = options.args || process.argv.slice(2);
  const env = options.env || process.env;
  const logger = options.logger || console;

  let asset;
  try {
    asset = assetFor(osPlatform, osArch);
  } catch (err) {
    logger.error(`mem-mcp: ${err.message}`);
    return 1;
  }

  let binPath = join(binDir, asset);

  try {
    // install() verifies an existing cache against the versioned manifest and
    // downloads the binary only when it is missing or fails verification.
    binPath = await bootstrap({
      osPlatform,
      osArch,
      binDir,
      logger: installerLogger(logger),
    });
  } catch (err) {
    logger.error(
      `mem-mcp: failed to download and verify the platform binary: ${err.message}`,
    );
    logger.error(
      `mem-mcp: retry the command, or build manually from https://github.com/fullstack-ai-infra/mem`,
    );
    return 1;
  }

  return new Promise((resolve) => {
    let child;
    try {
      child = spawnProcess(binPath, args, { env, stdio: "inherit" });
    } catch (err) {
      logger.error(`mem-mcp: failed to start ${binPath}: ${err.message}`);
      resolve(1);
      return;
    }

    let settled = false;
    const finish = (code) => {
      if (settled) return;
      settled = true;
      resolve(code);
    };

    child.once("error", (err) => {
      if (!settled) {
        logger.error(`mem-mcp: failed to start ${binPath}: ${err.message}`);
      }
      finish(1);
    });

    child.once("exit", (code, signal) => {
      finish(signal ? 1 : code === null ? 1 : code);
    });
  });
}

if (require.main === module) {
  run().then(
    (code) => {
      process.exitCode = code;
    },
    (err) => {
      console.error(`mem-mcp: unexpected wrapper failure: ${err.message}`);
      process.exitCode = 1;
    },
  );
}

module.exports = { installerLogger, run };
